# Entrega a cliente: deja la demostración apagada.
VITE_DEMO=false

# WhatsApp Cloud API (Meta). Sin estas variables la bandeja no envía ni recibe.
# Guía: Meta Business Manager → app Business → WhatsApp → API Setup.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Cuenta de WhatsApp (WABA). Hace falta para guardar lo que se escribe en el celular.
WA_WABA_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Nombre de la plantilla aprobada en español (por defecto reserva_nueva).
# WA_TEMPLATE=reserva_nueva
# Solo si Meta firma los avisos con una clave que no es la de la app y la firma nunca coincide:
# con 1 se aceptan avisos sin firma válida únicamente desde las redes de Meta y con el número de la tienda.
# WA_TRUST_META_NETWORK=1
