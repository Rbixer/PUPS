# Entrega a cliente: deja la demostración apagada.
VITE_DEMO=false

# WhatsApp Cloud API (Meta). Sin estas variables la bandeja no envía ni recibe.
# Guía: Meta Business Manager → app Business → WhatsApp → API Setup.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
